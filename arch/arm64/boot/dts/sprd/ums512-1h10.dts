		supply-type-sel = < 0x120 0x00 0x01 >;
		top-dvfs-i2c-state = < 0x9c 0x04 0x0f >;
		voltage-grade-num = < 0x06 >;
		voltage-grade = < 0x00 0x0f 0x12c 0x00 0x7f 0x01 0x14 0x12c 0x07 0x7f 0x02 0x19 0x12c 0x0e 0x7f 0x03 0x1e 0x12c 0x15 0x7f 0x04 0x23 0x130 0x00 0x7f 0x05 0x28 0x130 0x07 0x7f >;
