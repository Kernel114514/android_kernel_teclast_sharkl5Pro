		charge-sdp-current-microamp = < 0x19f0a0 0x1b7740 >;
		charge-dcp-current-microamp = < 0x1c3a90 0x200b20 >;
		charge-cdp-current-microamp = < 0x1c3a90 0x200b20 >;
		charge-unknown-current-microamp = < 0x19f0a0 0x1b7740 >;
		phandle = < 0x2c >;
	};

	charger-manager {
		compatible = "charger-manager";
		cm-name = "battery";
		cm-poll-mode = < 0x02 >;
		cm-poll-interval = < 0x3a98 >;
		cm-battery-stat = < 0x02 >;
		cm-fullbatt-vchkdrop-ms = < 0x7530 >;
		cm-fullbatt-vchkdrop-volt = < 0xea60 >;
		cm-fullbatt-voltage = < 0x41eb00 >;
		cm-fullbatt-current = < 0x222e0 >;
		cm-fullbatt-capacity = < 0x64 >;
		cm-num-chargers = < 0x01 >;
		cm-chargers = "bq2560x_charger";
		cm-fuel-gauge = "sc27xx-fgu";
		cm-battery-cold = < 0xc8 >;
		cm-battery-cold-in-minus;
		cm-battery-hot = < 0x320 >;
		cm-battery-temp-diff = < 0x64 >;
		cm-charging-max = < 0x1499700 >;
		cm-discharging-max = < 0x2932e0 >;
		cm-wdt-interval = < 0x3c >;
		cm-shutdown-voltage = < 0x2f4d60 >;
		cm-tickle-time-out = < 0x1f4 >;
		cm-one-cap-time = < 0x1e >;
		sprd,usb-dc-gpios = < 0x11a 0x0c 0x00 >;
		cm-charge-voltage-max = < 0x632ea0 >;
		cm-charge-voltage-drop = < 0xaae60 >;
		cm-jeita-temp-table = < 0x3e8 0x406 0x00 0x432380 0x47e 0x49c 0x1c3a90 0x432380 0x5aa 0x58c 0x1c3a90 0x432380 0x640 0x622 0x124f80 0x432380 >;

		regulator@0 {
			cm-regulator-name = "vddgen0";

			cable@0 {
				cm-cable-name = "USB";
				extcon = < 0x11b >;
			};
		};
	};

	dvfs-dcdc-cpu0-supply {
		pmic-type-num = < 0x00 >;
		slew-rate = < 0x249f >;
		top-dvfs-adi-state = < 0x70 0x00 0x0f >;
		voltage-grade-num = < 0x07 >;
		voltage-grade = < 0x00 0xf0 0xf4 0x00 0x1ff 0x01 0xf0 0xf4 0x09 0x1ff 0x02 0x100 0xf4 0x12 0x1ff 0x03 0x110 0xf8 0x00 0x1ff 0x04 0x120 0xf8 0x09 0x1ff 0x05 0x130 0xf8 0x12 0x1ff 0x06 0x140 0xfc 0x00 0x1ff >;
