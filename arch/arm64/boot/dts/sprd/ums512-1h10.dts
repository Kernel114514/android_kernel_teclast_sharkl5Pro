	sprd-pcm-iis {
		compatible = "sprd,sharkl5-pcm-platform";
		#sound-dai-cells = < 0x00 >;
		dmas = < 0x108 0x05 0x108 0x06 >;
		dma-names = "iis0_tx\0iis0_rx";
		sprd,dma-2stage-usecase = < 0x02 >;
		sprd,node-count-2stage-level-1 = < 0x01 >;
		sprd,syscon-pmu-apb = < 0x02 >;
		sprd,dma-2stage-level-1-int-source = < 0x01 >;
		phandle = < 0x109 >;
	};

	sound@1 {
		compatible = "sprd,i2s-null-codec";
		status = "okay";
		sprd-audio-card,name = "all-i2s";
		phandle = < 0x1bf >;

		sprd-audio-card,dai-link@0 {

			plat {
				sound-dai = < 0x109 >;
			};

			cpu {
				sound-dai = < 0x10a >;
			};

			codec {
				sound-dai = < 0x00 0x00 >;
			};
		};
	};

	memory {
		device_type = "memory";
		reg = < 0x00 0x80000000 0x00 0x80000000 >;
		phandle = < 0x10c >;
	};

	chosen {
		stdout-path = "/soc/ap-apb/serial@70100000";
		bootargs = "earlycon=sprd_serial,0x70100000,115200n8 console=ttyS1,115200n8 loglevel=1 init=/init root=/dev/ram0 rw androidboot.hardware=ums512_1h10 androidboot.dtbo_idx=0 printk.devkmsg=on androidboot.boot_devices=soc/soc:ap-apb/71400000.sdio swiotlb=1";
	};

	interrupt-controller {
		compatible = "android,CustomIPI";
		#interrupt-cells = < 0x01 >;
		interrupt-controller;
		phandle = < 0x10b >;
	};

	trusty {
		compatible = "android,trusty-smc-v1";

		irq {
			compatible = "android,trusty-irq-v1";
			interrupt-templates = < 0x10b 0x00 0x01 0x01 0x01 0x00 0x01 0x01 0x00 0x00 >;
			interrupt-ranges = < 0x00 0x0f 0x00 0x10 0x1f 0x01 0x20 0xdf 0x02 >;
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};

		log {
			compatible = "android,trusty-log-v1";
		};
	};

	sprd-sysdump {
		memory-region = < 0x10c >;
		memory-region-re = < 0x10d 0x10e 0x10f 0x110 0x111 0xcd 0xce >;
		memory-region-se = < 0x112 0x113 >;
	};

	sprd-iq {
		compatible = "sprd,iq";
		sprd,region = < 0x114 >;
		sprd,mapping-offs = < 0x00 >;
	};

	ion {
		compatible = "sprd,ion";
		#address-cells = < 0x01 >;
		#size-cells = < 0x00 >;
		phandle = < 0x1c0 >;

		heap@1 {
			reg = < 0x01 >;
			label = "carveout_mm";
			type = < 0x02 >;
		};

		heap@2 {
			reg = < 0x02 >;
			label = "carveout_overlay";
			type = < 0x02 >;
		};

		heap@3 {
			reg = < 0x03 >;
			label = "carveout_fb";
			type = < 0x02 >;
			memory-region = < 0x115 >;
		};
	};

	sprd-marlin3 {
		compatible = "sprd,marlin3";
		m2-to-ap-coexist-gpios = < 0x23 0x77 0x01 >;
		m2-wakeup-ap-gpios = < 0x23 0x20 0x01 >;
		permit-ap-send-gpios = < 0x23 0x79 0x01 >;
		reset-gpios = < 0x23 0x5f 0x01 >;
		enable-gpios = < 0x23 0x8f 0x01 >;
		m2-to-ap-irq-gpios = < 0x23 0x5e 0x01 >;
		avdd12-supply = < 0x116 >;
		avdd33-supply = < 0x117 >;
		dcxo18-supply = < 0x118 >;
		clock-names = "clk_32k\0source\0enable";
		clocks = < 0x2a 0x02 0xa1 0x04 0x03 >;
		sdhci-name = < 0x119 >;
		sprd,btwf-file-name = "/dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/wcnmodem";
		sprd,gnss-file-name = "/dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/gnssmodem";
		adma-tx;
		adma-rx;
		avdd12-parent-bound-chip = < 0x1a4c 0x01 0x00 0x01 >;
		avdd12-bound-wbreq = < 0x1ac8 0x1000 0x00 0x1000 >;
		avdd33-bound-wbreq = < 0x1acc 0x04 0x00 0x04 >;
		post-power-on-delay-ms = < 0x14 >;
		phandle = < 0x1c1 >;
	};

	sprd-mtty {
		compatible = "sprd,mtty";
		sprd,name = "ttyBT";
	};

	sprd-fm {
		compatible = "sprd,marlin3-fm";
		sprd,name = "sprd-fm";
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = < 0x588040 >;
		charge-term-current-microamp = < 0x1d4c0 >;
		constant_charge_voltage_max_microvolt = < 0x432380 >;
		factory-internal-resistance-micro-ohms = < 0x15ba8 >;
		voltage-min-design-microvolt = < 0x34a490 >;
		ocv-capacity-celsius = < 0x14 >;
		ocv-capacity-table-0 = < 0x41b068 0x64 0x40b280 0x5f 0x3fef30 0x5a 0x3f56d8 0x55 0x3e9388 0x50 0x3dff18 0x4b 0x3d4398 0x46 0x3ca370 0x41 0x3c1ab8 0x3c 0x3b6ed8 0x37 0x3b0948 0x32 0x3a9fd0 0x2d 0x3a3658 0x28 0x39f008 0x23 0x39a9b8 0x1e 0x396f20 0x19 0x391d18 0x14 0x38afb8 0x0f 0x3836a0 0x0a 0x37c170 0x05 0x34a490 0x00 >;
