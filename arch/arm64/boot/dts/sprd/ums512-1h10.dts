	extcon-gpio {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpio = < 0x58 0x00 0x00 >;
		id-gpio = < 0x11a 0x04 0x00 >;
		phandle = < 0x2d >;
	};

	gnss_common_ctl {
		compatible = "sprd,gnss_common_ctl";
		sprd,name = "gnss_common_ctl";
	};

